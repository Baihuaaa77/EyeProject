<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份与换机规则，与 backup_rules.xml 保持一致。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="eyeproject_session.xml" />
        <exclude domain="file" path="screening_outbox.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="eyeproject_session.xml" />
        <exclude domain="file" path="screening_outbox.json" />
    </device-transfer>
</data-extraction-rules>
